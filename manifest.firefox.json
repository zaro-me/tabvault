{
  "manifest_version": 3,
  "name": "TabVault",
  "version": "0.1.0",
  "description": "Intelligently parks idle tabs, reclaiming memory while keeping everything organized.",
  "permissions": [
    "tabs",
    "storage",
    "alarms",
    "notifications",
    "contextMenus",
    "downloads"
  ],
  "host_permissions": ["<all_urls>"],
  "background": {
    "scripts": ["src/background/service-worker.ts"],
    "type": "module"
  },
  "action": {
    "default_popup": "src/popup/index.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_page": "src/options/index.html",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "tabvault@tabvault.dev",
      "strict_min_version": "109.0"
    }
  }
}
